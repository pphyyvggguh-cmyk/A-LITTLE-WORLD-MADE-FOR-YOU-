    "JarPoolThought": {
      "title": "JarPoolThought",
      "description": "Approved, anonymized thought inside Wulan's active glass jar pool.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique pool thought identifier matching JarThought ID."
        },
        "displayAuthor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Masked author label (Someone Special when anonymous)."
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether original author requested anonymity."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Approved note body."
        },
        "paperStyle": {
          "type": "string",
          "enum": ["ivory-linen", "blush-petal", "sage-leaf", "champagne-gold", "burgundy-tint"],
          "description": "Selected archival stationery style."
        },
        "isApproved": {
          "type": "boolean",
          "description": "Always true inside jarPool."
        },
        "opened": {
          "type": "boolean",
          "description": "One-time reveal flag."
        },
        "openedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp recorded on reveal."
        },
        "sortSeed": {
          "type": "number",
          "description": "Random seed between 0 and 1."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "displayAuthor",
        "isAnonymous",
        "message",
        "paperStyle",
        "isApproved",
        "opened",
        "sortSeed",
        "createdAt",
        "updatedAt"
      ]
    },
