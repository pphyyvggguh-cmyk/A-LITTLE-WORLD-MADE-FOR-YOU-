  "firestore": {
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Stores verified administrator accounts permitted to mutate site content and media."
    },
    "/config/{configId}": {
      "schema": {
        "$ref": "#/entities/AccessConfig"
      },
      "description": "Stores private couple authorization emails and privacy configuration (config/access)."
    },
    "/siteContent/{sectionId}": {
      "schema": {
        "$ref": "#/entities/SiteContentSection"
      },
      "description": "Stores partitioned public website content sections (story, world, letters, video, miniOktaf, vinyl)."
    },
    "/voices/{voiceId}": {
      "schema": {
        "$ref": "#/entities/VoiceEntry"
      },
      "description": "Stores individual Voices of Love friend audio cards."
    },
    "/vinylPlaylist/{trackId}": {
      "schema": {
        "$ref": "#/entities/VinylTrack"
      },
      "description": "Stores YouTube playlist entries for Our Little Vinyl Player."
    },
    "/wishlist/{wishId}": {
      "schema": {
        "$ref": "#/entities/WishlistEntry"
      },
      "description": "Stores public, private, and shared couple wishlist entries for Our Future Wishlist."
    },
    "/postcards/{postcardId}": {
      "schema": {
        "$ref": "#/entities/PostcardEnvelope"
      },
      "description": "Stores envelope metadata for Postcards From The Future without exposing time-locked messages or photos."
    },
    "/postcards/{postcardId}/secret/{secretId}": {
      "schema": {
        "$ref": "#/entities/PostcardSecret"
      },
      "description": "Stores time-locked postcard messages and optional photos readable only after request.time >= parent.unlockAt."
    },
    "/mediaAssets/{assetId}": {
      "schema": {
        "$ref": "#/entities/MediaAssetMeta"
      },
      "description": "Stores index metadata for Firebase Storage uploads managed in Admin Dashboard."
    },
    "/secretNotes/{noteId}": {
      "schema": {
        "$ref": "#/entities/SecretNote"
      },
      "description": "Stores Our Story secret notes assignable to specific scrapbook pages (publicly readable only when enabled == true)."
    },
    "/jarThoughts/{thoughtId}": {
      "schema": {
        "$ref": "#/entities/JarThought"
      },
      "description": "Stores public friend submissions and admin moderation queue for A Jar Full of Thoughts (strictly admin-only reads)."
    },
    "/jarPool/{thoughtId}": {
      "schema": {
        "$ref": "#/entities/JarPoolThought"
      },
      "description": "Stores approved, anonymized messages inside Wulan's active glass jar pool with atomic one-time reveal locking."
    },
    "/jarState/{stateId}": {
      "schema": {
        "$ref": "#/entities/JarCooldownState"
      },
      "description": "Stores server-time-enforced 24-hour reveal cooldown state (jarState/cooldown)."
    },
    "/heartGallery/{photoId}": {
      "schema": {
        "$ref": "#/entities/HeartGalleryPhoto"
      },
      "description": "Stores curated photos, captions, and decorative themes for Quest 3's Our Little Heart Gallery."
    },
    "/voiceSubmissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/VoiceSubmission"
      },
      "description": "Stores pending public Voices of Love contributions awaiting admin moderation (strictly admin-only reads)."
    },
    "/contributionBatches/{batchId}": {
      "schema": {
        "$ref": "#/entities/ContributionBatch"
      },
      "description": "Stores atomic linkage between unified /leave-a-thought Jar and Voice contributions (strictly admin-only reads)."
    },
    "/mediaBlobs/{blobId}": {
      "schema": {
        "$ref": "#/entities/MediaBlob"
      },
      "description": "Stores persistent compressed image payloads in Firestore for cross-device rendering via /api/media?id={blobId}."
    }
  }
}
