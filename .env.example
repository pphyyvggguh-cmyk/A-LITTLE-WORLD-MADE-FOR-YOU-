# GEMINI_API_KEY: Required if server-side Gemini AI features are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Firebase configuration is stored in /firebase-applet-config.json (projectId,
# apiKey, authDomain, storageBucket, firestoreDatabaseId).
# Never commit Firebase private service-account keys or user credentials.
